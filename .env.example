# Kopiraj ovaj fajl u .env (ili .env.local) i popuni vrednosti.
# .env se NE commituje (u .gitignore je).
#
# PAŽNJA: sve VITE_* promenljive se ugrađuju u JavaScript koji ide u browser.
# Na javnom sajtu (GitHub Pages) svako može da ih pročita. Koristi ih za lokalni
# rad ili privatni deploy. Na javnom sajtu je bezbednije da korisnik unese ključ
# u aplikaciji (dugme "Upload slika"), jer se tada čuva samo u njegovom browseru.

# Podrazumevani servis za upload loga: imgbb ili imgur
VITE_UPLOAD_PROVIDER=imgbb

# https://api.imgbb.com/
VITE_IMGBB_API_KEY=

# https://api.imgur.com/oauth2/addclient
VITE_IMGUR_CLIENT_ID=

# Adresa Cloudflare Workera za naziv pesme (README, "Naziv pesme"). Nije tajna:
# Worker prima zahteve samo sa sajtova iz ALLOWED_ORIGINS u worker/wrangler.toml.
# Primer: https://m3u-now-playing.tvoje-ime.workers.dev  (lokalno: http://localhost:8787)
VITE_NOWPLAYING_URL=
