{
  "name": "m3u-manager",
  "private": true,
  "version": "0.1.0",
  "description": "M3U Studio: pravljenje i uređivanje .m3u plejlisti internet radio stanica",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "npx --yes wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "npx --yes wrangler deploy --config worker/wrangler.toml"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "hls.js": "^1.7.3"
  }
}
